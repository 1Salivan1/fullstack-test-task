# ---------------------------------------------------------------------------
# Database (Neon Postgres)
# DATABASE_URL  -> pooled connection ("-pooler" host), used by the app runtime
# DIRECT_URL    -> direct connection (no "-pooler"), used by prisma migrate
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Secret used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="change-me"

# Optional. Google AI Studio key (free tier) -> https://aistudio.google.com/apikey
# When empty, every AI feature transparently falls back to its deterministic engine.
GEMINI_API_KEY=""

# Password shared by all seeded demo accounts.
DEMO_PASSWORD="demo1234"
